   efirst=   1.102479266030699d-2,
   deltaeng= 5.5123963301538D-4      !3.674930886769200d-4                       
   nenergy= 121
 $end
  
 $basis_n
   lam_n=100,     ! The sum of this array is the number of propagation channels (117)
   lamfst=0,      ! Starting index of Lam_n
   lamlst=0       ! Beginning index of Lam_n
 $end
  
 $regins
   start=2.1d0,
   SwitchToVIVS=8.1d0,
   finish=8.1d0,
   endaph=8.1d0,
   enddelve=8.1d0
 $end
 
 $logder
